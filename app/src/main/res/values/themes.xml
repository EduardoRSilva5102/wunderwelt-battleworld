<resources>
    <style name="Base.Theme.Wunderwelt" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/military_green</item>
        <item name="colorOnPrimary">@color/ivory</item>
        <item name="colorSecondary">@color/imperial_gold</item>
        <item name="colorOnSecondary">@color/charcoal</item>
        <item name="colorSurface">@color/charcoal</item>
        <item name="colorOnSurface">@color/ivory</item>
        <item name="android:colorAccent">@color/imperial_gold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/charcoal</item>
        <item name="android:statusBarColor">@color/charcoal</item>
        <item name="android:windowBackground">@color/charcoal</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Wunderwelt" parent="Base.Theme.Wunderwelt" />

    <style name="Theme.Wunderwelt.Starting" parent="Theme.Wunderwelt">
        <item name="android:windowSplashScreenBackground">@color/charcoal</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
    </style>
</resources>
