<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/introFragment">

    <fragment
        android:id="@+id/introFragment"
        android:name="com.hexinteractive.wunderwelt.ui.intro.IntroFragment"
        android:label="Introdução">
        <action android:id="@+id/action_intro_to_race" app:destination="@id/raceFragment" />
        <action android:id="@+id/action_intro_to_marvel" app:destination="@id/marvelFragment" />
        <action android:id="@+id/action_intro_to_credits" app:destination="@id/creditsFragment" />
    </fragment>
    <fragment
        android:id="@+id/raceFragment"
        android:name="com.hexinteractive.wunderwelt.ui.character.RaceFragment"
        android:label="Raça">
        <action android:id="@+id/action_race_to_class" app:destination="@id/classFragment" />
    </fragment>
    <fragment
        android:id="@+id/classFragment"
        android:name="com.hexinteractive.wunderwelt.ui.character.ClassFragment"
        android:label="Classe">
        <action android:id="@+id/action_class_to_region" app:destination="@id/regionFragment" />
    </fragment>
    <fragment
        android:id="@+id/regionFragment"
        android:name="com.hexinteractive.wunderwelt.ui.character.RegionFragment"
        android:label="Região">
        <action android:id="@+id/action_region_to_attributes" app:destination="@id/attributesFragment" />
    </fragment>
    <fragment
        android:id="@+id/attributesFragment"
        android:name="com.hexinteractive.wunderwelt.ui.character.AttributesFragment"
        android:label="Atributos">
        <action android:id="@+id/action_attributes_to_summary" app:destination="@id/characterSummaryFragment" />
    </fragment>
    <fragment
        android:id="@+id/characterSummaryFragment"
        android:name="com.hexinteractive.wunderwelt.ui.character.CharacterSummaryFragment"
        android:label="Resumo">
        <action
            android:id="@+id/action_summary_to_story"
            app:destination="@id/storyFragment"
            app:popUpTo="@id/introFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/storyFragment"
        android:name="com.hexinteractive.wunderwelt.ui.story.StoryFragment"
        android:label="História">
        <action android:id="@+id/action_story_to_battle" app:destination="@id/battleFragment" />
        <action android:id="@+id/action_story_to_marvel" app:destination="@id/marvelFragment" />
    </fragment>
    <fragment
        android:id="@+id/battleFragment"
        android:name="com.hexinteractive.wunderwelt.ui.battle.BattleFragment"
        android:label="Batalha" />
    <fragment
        android:id="@+id/marvelFragment"
        android:name="com.hexinteractive.wunderwelt.ui.marvel.MarvelFragment"
        android:label="Arquivo Comic Vine">
        <action android:id="@+id/action_marvel_to_detail" app:destination="@id/characterDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/characterDetailFragment"
        android:name="com.hexinteractive.wunderwelt.ui.marvel.CharacterDetailFragment"
        android:label="Detalhes">
        <argument android:name="characterId" app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/creditsFragment"
        android:name="com.hexinteractive.wunderwelt.ui.credits.CreditsFragment"
        android:label="Créditos" />
</navigation>
